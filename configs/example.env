# Repository and prepared runtime paths on the host.
RUNTIME_ROOT=/auto/home/USER/uav-sim-runtime
DATA_ROOT=/mnt/BULK/uav-sim

# NVIDIA Isaac Sim container and GPU selection.
ISAAC_IMAGE=nvcr.io/nvidia/isaac-sim:5.1.0
GPU_DEVICE=0
# Keep each PX4/MAVLink instance isolated when launching concurrent GPU shards.
DOCKER_NETWORK_MODE=bridge

# Dataset definition.
DATASET_NAME=natural-valley-v2
EPISODE_START=0
EPISODE_END=9
SEED_BASE=5200
MAX_ATTEMPTS=3

# Playback deployment.
PORT=8787
