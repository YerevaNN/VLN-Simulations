# Repository and prepared runtime paths on the host.
RUNTIME_ROOT=/auto/home/USER/uav-sim-runtime
DATA_ROOT=/mnt/BULK/uav-sim

# NVIDIA Isaac Sim container and GPU selection. Image is resolved to immutable ID.
ISAAC_IMAGE=nvcr.io/nvidia/isaac-sim:5.1.0
GPU_DEVICE=0
# Only bridge is supported: each PX4/MAVLink instance requires private ports.
DOCKER_NETWORK_MODE=bridge
ISAAC_CPU_THREADS=24

# Dataset definition. A changed configuration requires a fresh dataset name.
DATASET_NAME=natural-valley-navigation-v1
EPISODE_START=0
EPISODE_END=9
SEED_BASE=5200
MAX_ATTEMPTS=3
# Wall-clock bounds include startup; timeout kills the named worker container.
EPISODE_TIMEOUT_SECONDS=7200
VALIDATION_TIMEOUT_SECONDS=1800
# Opt-in application reuse (1..8). Each episode still gets a fresh world and PX4.
PERSISTENT_EPISODES_PER_WORKER=1
# Optional cohort watchdog; default is EPISODE_TIMEOUT_SECONDS * group size.
# PERSISTENT_WORKER_TIMEOUT_SECONDS=14400

# Playback deployment.
PORT=8787
